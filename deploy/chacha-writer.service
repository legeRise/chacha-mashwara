[Unit]
Description=Chacha Mashwara script writer API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/chacha-mashwara
Environment=HOME=/home/ubuntu
Environment=WRITER_MODEL=opencode-go/claude-haiku-5-5
Environment=OPENCODE_BIN=/home/ubuntu/.opencode/bin/opencode
ExecStart=/usr/bin/python3 /home/ubuntu/chacha-mashwara/tools/writer_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
